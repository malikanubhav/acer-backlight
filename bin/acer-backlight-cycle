#!/bin/bash
# Cycle through a preset list of colours (bound to Ctrl+Alt+C).
# Full brightness each time; a colour write persists as the new boot/resume
# default automatically (acer-backlight >= 1.8.0), so cycling also fixes an
# "off" state left over from the toggle/GUI power button.
#
# Trailing debounce (see acer-backlight-toggle for why): GNOME fires this
# once per key-repeat event for as long as the combo is held, not once per
# press, so a hold can otherwise skip several colours at once.
STATE=~/.cache/acer-backlight-cycle-state
LOCK=~/.cache/acer-backlight-cycle-pending
BIN=/usr/local/bin/acer-backlight
COLOURS=(warm red amber orange yellow lime green mint teal cyan sky blue purple violet magenta pink white)

echo $$ > "$LOCK"
sleep 0.2
[[ "$(cat "$LOCK" 2>/dev/null)" == "$$" ]] || exit 0

idx=$(cat "$STATE" 2>/dev/null)
[[ $idx =~ ^[0-9]+$ ]] || idx=-1
idx=$(( (idx + 1) % ${#COLOURS[@]} ))
echo "$idx" > "$STATE"

sudo -n "$BIN" -b 100 "${COLOURS[$idx]}" >/dev/null 2>&1
echo on > ~/.cache/acer-backlight-toggle-state
notify-send -t 1200 "Keyboard backlight" "${COLOURS[$idx]}" 2>/dev/null
