#!/bin/bash
# Toggle the Acer keyboard backlight on/off (bound to Ctrl+Alt+K).
#
# Off uses `sleep-prep` (blank + master disable) rather than the "off" colour,
# so a manual toggle-off never overwrites the persisted boot/resume colour —
# only an explicit colour choice (GUI or CLI) should ever change what comes
# back after suspend. On uses `restore`, the same double-pass re-init the
# resume hook uses, so the toggle is exactly as robust as suspend/resume.
#
# Trailing debounce: GNOME fires this once per key-repeat event for as long
# as the combo is held (confirmed — dozens of invocations from a single
# multi-second hold), not once per physical press. A fixed "ignore the next
# 500ms" throttle still lets a long hold fire twice and cancel itself out.
# Instead: claim a lock with our own PID, wait, and only act if no later
# invocation has since claimed it — so a repeat storm collapses to exactly
# one action, firing shortly after the key is actually released.
STATE=~/.cache/acer-backlight-toggle-state
LOCK=~/.cache/acer-backlight-toggle-pending
BIN=/usr/local/bin/acer-backlight

echo $$ > "$LOCK"
sleep 0.2
[[ "$(cat "$LOCK" 2>/dev/null)" == "$$" ]] || exit 0

if [[ "$(cat "$STATE" 2>/dev/null)" == off ]]; then
    sudo -n "$BIN" restore >/dev/null 2>&1
    echo on > "$STATE"
else
    sudo -n "$BIN" sleep-prep >/dev/null 2>&1
    echo off > "$STATE"
fi
