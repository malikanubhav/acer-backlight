#!/bin/bash
# Toggle the Acer keyboard backlight on/off (bound to Ctrl+Alt+K).
#
# Off uses `sleep-prep` (blank + master disable) rather than the "off" colour,
# so a manual toggle-off never overwrites the persisted boot/resume colour —
# only an explicit colour choice (GUI or CLI) should ever change what comes
# back after suspend. On uses `restore`, the same double-pass re-init the
# resume hook uses, so the toggle is exactly as robust as suspend/resume.
STATE=~/.cache/acer-backlight-toggle-state
BIN=/usr/local/bin/acer-backlight

if [[ "$(cat "$STATE" 2>/dev/null)" == off ]]; then
    sudo -n "$BIN" restore >/dev/null 2>&1
    echo on > "$STATE"
else
    sudo -n "$BIN" sleep-prep >/dev/null 2>&1
    echo off > "$STATE"
fi
