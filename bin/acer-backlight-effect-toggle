#!/bin/bash
# Cycle through every motion effect, off included (bound to Ctrl+Alt+E).
STATE=~/.cache/acer-backlight-effect-state
DEBOUNCE=~/.cache/acer-backlight-effect-lastrun
BIN=/usr/local/bin/acer-backlight
MODES=(off breathe rainbow strobe colorloop shift heartbeat flicker reactive)
# Seconds-per-cycle tuned per effect; ignored by off, flicker's own randomiser, and reactive.
PERIODS=(0   3       4        0.4     1.5        6      1         3        0)

# Key auto-repeat on a slightly-held combo can fire this twice in a blink,
# skipping an effect without the user meaning to. Ignore a repeat within 500ms.
now=${EPOCHREALTIME/./}
last=$(cat "$DEBOUNCE" 2>/dev/null)
[[ $last =~ ^[0-9]+$ ]] || last=0
(( now - last < 500000 )) && exit 0
echo "$now" > "$DEBOUNCE"

idx=$(cat "$STATE" 2>/dev/null)
[[ $idx =~ ^[0-9]+$ ]] || idx=-1
idx=$(( (idx + 1) % ${#MODES[@]} ))
echo "$idx" > "$STATE"
mode=${MODES[$idx]}

sudo -n "$BIN" effect "$mode" "${PERIODS[$idx]}" >/dev/null 2>&1
echo on > ~/.cache/acer-backlight-toggle-state
notify-send -t 1200 "Keyboard backlight effect" "$mode" 2>/dev/null
