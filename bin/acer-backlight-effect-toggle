#!/bin/bash
# Cycle through every motion effect, off included (bound to Ctrl+Alt+E).
STATE=~/.cache/acer-backlight-effect-state
BIN=/usr/local/bin/acer-backlight
MODES=(off breathe rainbow strobe colorloop heartbeat flicker)
# Seconds-per-cycle tuned per effect; ignored by off and by flicker's own randomiser.
PERIODS=(0   3       4        0.4     1.5        1         3)

idx=$(cat "$STATE" 2>/dev/null)
[[ $idx =~ ^[0-9]+$ ]] || idx=-1
idx=$(( (idx + 1) % ${#MODES[@]} ))
echo "$idx" > "$STATE"
mode=${MODES[$idx]}

sudo -n "$BIN" effect "$mode" "${PERIODS[$idx]}" >/dev/null 2>&1
echo on > ~/.cache/acer-backlight-toggle-state
notify-send -t 1200 "Keyboard backlight effect" "$mode" 2>/dev/null
