#!/usr/bin/env python3
"""acer-backlight-effectd — background animation loop for the Acer keyboard backlight.

Only ever writes ACPI fn 0x67 (keyboard lighting), same interface acer-backlight uses.
Not meant to be run directly: `acer-backlight effect <mode> [seconds]` starts/stops
this as a tracked background process. Modes: breathe, rainbow, strobe, colorloop,
heartbeat, flicker, reactive.

Single-zone hardware (verified — see docs/PROTOCOL.md), so "motion" here means the
whole keyboard changing over time, not light travelling across keys — reactive mode
flashes the whole board on any keypress, not just the key you hit, for the same reason.
"""
import sys, os, time, math, random, struct, select, colorsys, signal

CALL = "/proc/acpi/call"
M = r"\_SB.WMI.WMBB"
CHANNEL_ORDER = os.environ.get("CHANNEL_ORDER", "BRG")
ZONES = (0, 1, 2, 3)
NAMED = {
    "off": "000000", "black": "000000", "white": "ffffff", "red": "ff0000",
    "green": "00ff00", "blue": "0000ff", "yellow": "ffff00", "cyan": "00ffff",
    "magenta": "ff00ff", "purple": "8000ff", "orange": "ff5000", "pink": "ff2080",
    "teal": "00ff80", "warm": "ffb060",
    "lime": "80ff00", "sky": "00aaff", "violet": "aa00ff", "amber": "ffaa00", "mint": "00ffaa",
}


def wmbb(args):
    bb = "b%02x%02x%02x%02x" % (args & 0xFF, (args >> 8) & 0xFF, (args >> 16) & 0xFF, (args >> 24) & 0xFF)
    try:
        open(CALL, "w").write(f"{M} 0x0 0x67 {bb}\n")
    except OSError:
        pass


def pack(r, g, b):
    vals = {"R": r, "G": g, "B": b}
    out = 0
    for i, c in enumerate(CHANNEL_ORDER):
        out |= vals[c] << (16 - i * 8)
    return out


def master(on):
    wmbb(0x40010000 if on else 0x40000000)


def paint(zone, r, g, b):
    wmbb(0xF0000000 | (zone << 24) | pack(r, g, b))


def base_colour():
    """The colour breathe fades around — whatever is set as the boot/resume default."""
    colour = "ffb060"
    try:
        for line in open("/etc/default/acer-backlight"):
            if line.startswith("COLOR="):
                colour = line.strip().split("=", 1)[1]
    except OSError:
        pass
    hexv = NAMED.get(colour.lower(), colour)
    if len(hexv) != 6:
        hexv = "ffb060"
    return tuple(int(hexv[i:i + 2], 16) for i in (0, 2, 4))


LOOP_COLOURS = ["warm", "red", "amber", "orange", "yellow", "lime", "green", "mint",
                "teal", "cyan", "sky", "blue", "purple", "violet", "magenta", "pink", "white"]


def hexrgb(name):
    hexv = NAMED.get(name, name)
    return tuple(int(hexv[i:i + 2], 16) for i in (0, 2, 4))


def find_keyboard_device():
    """/dev/input/eventN for the internal keyboard, resolved by name since the
    number can shift across reboots or machines."""
    try:
        for block in open("/proc/bus/input/devices").read().split("\n\n"):
            if 'Name="AT Translated Set 2 keyboard"' in block:
                for line in block.splitlines():
                    if line.startswith("H: Handlers="):
                        for tok in line.split("=", 1)[1].split():
                            if tok.startswith("event"):
                                return f"/dev/input/{tok}"
    except OSError:
        pass
    return "/dev/input/event4"


EVENT_FMT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FMT)
EV_KEY = 1

running = True


def _stop(*_):
    global running
    running = False


signal.signal(signal.SIGTERM, _stop)
signal.signal(signal.SIGINT, _stop)

mode = sys.argv[1] if len(sys.argv) > 1 else "breathe"
period = float(sys.argv[2]) if len(sys.argv) > 2 else 3.0
FPS = 30
dt = 1.0 / FPS

r0, g0, b0 = base_colour()
master(True)
t = 0.0
flicker_level, flicker_target, flicker_next = 1.0, 1.0, 0.0
last_press = -999.0
kbd_fd = None
if mode == "reactive":
    try:
        kbd_fd = os.open(find_keyboard_device(), os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        kbd_fd = None

while running:
    if mode == "breathe":
        level = (math.sin(2 * math.pi * t / period - math.pi / 2) + 1) / 2  # 0..1, starts dark
        r, g, b = round(r0 * level), round(g0 * level), round(b0 * level)

    elif mode == "rainbow":
        hue = (t / period) % 1.0
        rf, gf, bf = colorsys.hsv_to_rgb(hue, 1.0, 1.0)
        r, g, b = round(rf * 255), round(gf * 255), round(bf * 255)

    elif mode == "strobe":
        # Hard on/off square wave, not a fade — a snappy flash rather than breathe's fade.
        on = (t % period) < (period / 2)
        r, g, b = (r0, g0, b0) if on else (0, 0, 0)

    elif mode == "colorloop":
        # Discrete jump between preset colours, no fade — distinct from rainbow's
        # continuous hue sweep and from the manual Ctrl+Alt+C cycle shortcut.
        idx = int(t / period) % len(LOOP_COLOURS)
        r, g, b = hexrgb(LOOP_COLOURS[idx])

    elif mode == "heartbeat":
        # Two quick pulses then a pause, like a heart-rate monitor blip.
        p = (t % period) / period
        env = max(0.0, 1 - abs(p - 0.05) / 0.05, 1 - abs(p - 0.22) / 0.07)
        env = min(env, 1.0)
        r, g, b = round(r0 * env), round(g0 * env), round(b0 * env)

    elif mode == "flicker":
        # Candle-like: a new random brightness target every ~0.1-0.3s, smoothed
        # toward it each frame so it wavers instead of strobing.
        if t >= flicker_next:
            flicker_target = random.uniform(0.5, 1.0)
            flicker_next = t + random.uniform(0.1, 0.3)
        flicker_level += (flicker_target - flicker_level) * 0.2
        r, g, b = round(r0 * flicker_level), round(g0 * flicker_level), round(b0 * flicker_level)

    elif mode == "reactive":
        # Flash the whole board on any keypress, decaying back to a faint idle glow.
        # `period` is unused here — decay speed is fixed for a snappy typing feel.
        if kbd_fd is not None:
            ready, _, _ = select.select([kbd_fd], [], [], 0)
            if ready:
                try:
                    data = os.read(kbd_fd, EVENT_SIZE * 64)
                    for i in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
                        _, _, etype, _ecode, evalue = struct.unpack(EVENT_FMT, data[i:i + EVENT_SIZE])
                        if etype == EV_KEY and evalue in (1, 2):  # press or autorepeat
                            last_press = t
                except OSError:
                    pass
        level = max(0.06, math.exp(-(t - last_press) / 0.25))
        r, g, b = round(r0 * level), round(g0 * level), round(b0 * level)

    else:
        break
    for z in ZONES:
        paint(z, r, g, b)
    time.sleep(dt)
    t += dt
